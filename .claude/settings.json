{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git check-ignore*)",
      "Bash(python tools/precommit_check.py*)",
      "Bash(python tools/session_start_context.py)",
      "Bash(python3 tools/precommit_check.py*)",
      "Bash(python3 tools/session_start_context.py)",
      "Bash(python3 tools/cloud_check.py)",
      "Bash(python tools/cloud_check.py)",
      "Bash(python tools/watch_commit.py*)",
      "Bash(python tools/apply_rescore.py*)",
      "Bash(python tools/test_autonomy.py)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh repo *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/tools/session_start_context.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/tools/deliverable_reminder.py\""
          }
        ]
      }
    ]
  }
}
