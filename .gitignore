# Citation checker outputs and cache (regenerated on each run)
tools/citation-report.md
tools/citation-report.json
tools/.citation-cache.json

# Python
__pycache__/
*.pyc

# Local Claude Code settings and scratch
# Track the hook configuration (a global git ignore on this machine hides it by default)
!.claude/settings.local.json
.claude/sessions.log
scratch/
*.tmp

# Corpus full texts and PDFs stay local (copyrighted)
corpus/fulltext/

# Personal data (author contacts) stays local
corpus/local/

# Spreadsheet lock files (created while a workbook is open)
.~lock.*
~$*
